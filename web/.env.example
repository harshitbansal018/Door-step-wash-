# Copy this file to .env.local and fill in the values. Never commit .env.local.

# --- Supabase (Project Settings → API) ---------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server only. Full database access — never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Site ---------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Razorpay (Dashboard → Account & Settings → API Keys; use Test Mode first) --
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks → the secret you set on the webhook
RAZORPAY_WEBHOOK_SECRET=

# --- Emails (resend.com, free tier) -------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="ShineDoor <no-reply@yourdomain.com>"
