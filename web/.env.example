# Copy this file to .env.local and fill in the values. Never commit .env.local.

# --- Supabase (Project Settings → API) ---------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server only. Full database access — never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Site ---------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_SUPPORT_EMAIL=

# --- Razorpay (Dashboard → Account & Settings → API Keys; use Test Mode first) --
PAYMENTS_MODE=razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks → the secret you set on the webhook
RAZORPAY_WEBHOOK_SECRET=

# --- Transactional emails (Brevo) --------------------------------------------
# Used by the app for booking and worker notifications. Create an API key in
# Brevo's SMTP & API settings. The sender must be verified in Brevo.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@yourdomain.com
BREVO_SENDER_NAME=FoamValet
